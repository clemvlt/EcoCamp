    {
        "id": "765601bc77d3ed9b",
        "type": "function",
        "z": "274df5b471b70a74",
        "name": "config max",
        "func": "var newmsg={}\n\n\n// Seuils en pourcentage\nlet seuil1 = 0.6;   // 60%\nlet seuil2 = 0.85;  // 85%\n\n// Calcul des bornes\nlet s1 = msg.payload * seuil1;\nlet s2 = msg.payload * seuil2;\n\n// Configuration dynamique des segments\nnewmsg.ui_update = {\n    segments: [\n        {\n            from: 0,\n            color: \"#00b050\"   // vert\n        },\n        {\n            from: s1,\n            color: \"#ffb000\"   // orange\n        },\n        {\n            from: s2,\n            color: \"#e00000\"   // rouge\n        }\n    ],\n    max: msg.payload\n};\n\n\nreturn newmsg;",
        "outputs": 1,
