    {
        "id": "6a3b6fe9ad53b9f9",
        "type": "ui-template",
        "z": "555c17e9a449000e",
        "group": "1c53f384bae0b178",
        "page": "",
        "ui": "",
        "name": "Programme Defilement vertical",
        "order": 1,
        "width": 0,
        "height": 0,
        "head": "",
        "format": "<div class=\"programme-container\">\n  <div class=\"programme-title\">Programme</div>\n  <div class=\"table-wrapper\">\n    <table>\n      <thead>\n        <tr>\n          <th style=\"width:30%;\">Date</th>\n          <th style=\"width:20%;\">Heure</th>\n          <th style=\"width:50%;\">Activité</th>\n        </tr>\n      </thead>\n    </table>\n\n    <div class=\"scroll-zone\">\n      <div class=\"scroll-content\" :class=\"{ animate: items.length > 6 }\" :style=\"animationStyle\">\n        <table>\n          <tbody>\n            <tr v-for=\"(item, index) in duplicatedItems\" :key=\"index\">\n              <td style=\"width:30%;\">{{ item.date }}</td>\n              <td style=\"width:20%;\">{{ item.heure }}</td>\n              <td style=\"width:50%;\">{{ item.text }}</td>\n            </tr>\n          </tbody>\n        </table>\n      </div>\n    </div>\n\n  </div>\n</div>\n\n<style>\n  .programme-container {\n    width: 100%;\n    font-size: 16px;\n  }\n\n  .programme-title {\n    font-weight: bold;\n    font-size: 22px;\n    text-align: center;\n    margin-bottom: 10px;\n  }\n\n  .table-wrapper {\n    width: 100%;\n  }\n\n  .scroll-zone {\n    height: 240px;\n    /* 6 lignes x 40px */\n    overflow: hidden;\n    position: relative;\n  }\n\n  table {\n    width: 100%;\n    border-collapse: collapse;\n  }\n\n  th,\n  td {\n    padding: 6px;\n    text-align: left;\n  }\n\n  tbody tr {\n    height: 40px;\n  }\n\n  /* Alternance légère */\n  tbody tr:nth-child(even) {\n    background-color: rgba(0, 0, 0, 0.05);\n  }\n\n  /* Animation */\n  .animate {\n    animation: scrollUp linear infinite;\n  }\n\n  @keyframes scrollUp {\n    from {\n      transform: translateY(0);\n    }\n\n    to {\n      transform: translateY(-50%);\n    }\n  }\n</style>\n\n<script>\n  export default {\n  data() {\n    return {\n      items: []\n    }\n  },\n\n  computed: {\n    duplicatedItems() {\n      if (this.items.length > 6) {\n        return [...this.items, ...this.items]\n      }\n      return this.items\n    },\n\n    animationStyle() {\n      if (this.items.length > 6) {\n        return {\n          animationDuration: (this.items.length * 3) + \"s\"\n        }\n      }\n      return {}\n    }\n  },\n\n  watch: {\n    msg: {\n      handler(newMsg) {\n        if (Array.isArray(newMsg?.payload)) {\n          this.items = newMsg.payload\n        }\n      },\n      deep: true,\n      immediate: true\n    }\n  }\n}\n</script>",
        "storeOutMessages": true,
        "passthru": true,
        "resendOnRefresh": true,
        "templateScope": "local",
        "className": "",
        "x": 690,
        "y": 920,
        "wires": [
