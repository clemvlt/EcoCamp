    {
        "id": "30c8f2cbce75a2c0",
        "type": "function",
        "z": "555c17e9a449000e",
        "name": "formatage date_heure",
        "func": "// Tableaux en français\nconst jours = [\n    \"Dimanche\", \"Lundi\", \"Mardi\", \"Mercredi\",\n    \"Jeudi\", \"Vendredi\", \"Samedi\"\n];\n\nconst mois = [\n    \"Janvier\", \"Février\", \"Mars\", \"Avril\",\n    \"Mai\", \"Juin\", \"Juillet\", \"Août\",\n    \"Septembre\", \"Octobre\", \"Novembre\", \"Décembre\"\n];\n\n// Date actuelle\nlet now = new Date();\n\nlet jour = jours[now.getDay()];\nlet date = now.getDate();\nlet moisNom = mois[now.getMonth()];\n\nlet heures = now.getHours().toString().padStart(2, '0');\nlet minutes = now.getMinutes().toString().padStart(2, '0');\n\n// Format final\nmsg.ui_update = {\n    label: `${jour} ${date} ${moisNom}`\n};\n//msg.ui_update.label = `${jour} ${date} ${moisNom}`;\nmsg.payload = `${ heures }:${ minutes }`;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 320,
        "y": 800,
        "wires": [
            [
                "93def74eee21585b"
            ]
        ]
    },
