        "name": "Eau",
        "func": "let data = JSON.parse(msg.payload);\nlet historique = data.historique_7j;\n\n// garder valeurs valides\nhistorique = historique.filter(item => item.eau_L !== null);\n\nmsg.payload = historique.map(item => ({\n    x: item.date.split(\"-\").reverse().slice(0,2).join(\"/\"),\n    y: Number(item.eau_L)\n}));\n\nmsg.topic = \"Eau\";\nmsg.action = \"replace\";\n\nreturn msg;",
