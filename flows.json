        "name": "message_déroulant_Horizontal",
        "func": "let data = msg.payload;\n\nif (typeof data === \"string\") {\n    data = JSON.parse(data);\n}\n\nif (!data.messages || !Array.isArray(data.messages)) {\n    node.error(\"messages introuvable dans payload\");\n    return null;\n}\n\nmsg.payload = data.messages.map(message => {\n    return `${message.date_debut}, ${message.horaire}, ${message.contenu}`;\n}).join(\" ---- \");\n\nreturn msg;",
